<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="kas_kelas_clean_db" />
        <include domain="sharedpref" path="kas_reminder_prefs.xml" />
        <include domain="sharedpref" path="kas_student_roster.xml" />
        <include domain="sharedpref" path="kas_theme_prefs.xml" />
        <include domain="sharedpref" path="kas_drive_backup_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="kas_kelas_clean_db" />
        <include domain="sharedpref" path="kas_reminder_prefs.xml" />
        <include domain="sharedpref" path="kas_student_roster.xml" />
        <include domain="sharedpref" path="kas_theme_prefs.xml" />
        <include domain="sharedpref" path="kas_drive_backup_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
